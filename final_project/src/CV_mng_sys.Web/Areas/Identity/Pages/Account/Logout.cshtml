@page
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CV_mng_sys.Web.SharedResource> Localizer
@model LogoutModel
@{
    ViewData["Title"] = @Localizer["Logout"];
}

<header>
    <h1>@ViewData["Title"]</h1>
    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <button type="submit" class="nav-link btn btn-link">@Localizer["ClickHereLogout"]</button>
            </form>
        }
        else
        {
            <p>@Localizer["You have successfully logged out of the application."]</p>
        }
    }
</header>
