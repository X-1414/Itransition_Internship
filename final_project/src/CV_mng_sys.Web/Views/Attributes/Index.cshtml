@using System.ComponentModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CV_mng_sys.Web.SharedResource> Localizer
@using CV_mng_sys.Core.Entities
@model List<CV_mng_sys.Core.Entities.AttributeDefinition>
@{
    ViewData["Title"] = "Attributes";
}

<h1>@Localizer["AttributeLibrary"]</h1>
<p class="text-muted">@Localizer["This is a list of all attributes that Positions and Candidates can reference"]</p>

<!-- toolbar -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div id="toolbar">
        <button id="btnNew" class="btn btn-primary btn-sm">@Localizer["CreateNewAttribute"]</button>
        <button id="btnEdit" class="btn btn-secondary btn-sm" disabled>@Localizer["Edit"]</button>
        <button id="btnDelete" class="btn btn-outline-danger btn-sm" disabled>@Localizer["Delete"]</button>
    </div>
    <div>
        <input type="text" id="prefixSearch" class="form-control form-control-sm" placeholder="@Localizer["SearchByNamePrefix"]" style="width:220px;display:inline-block;" />
        <select id="categoryFilter" class="form-select form-select-sm" style="width:180px;display:inline-block;">
            <option value="">@Localizer["AllCategories"]</option>
            @foreach (var cat in Enum.GetValues<CV_mng_sys.Core.Entities.AttributeCategory>())
            {
                <option value="@cat">@Localizer[cat.ToString()]</option>
            }
        </select>
    </div>
</div>

<table class="table table-hover align-middle" id="attributesTable">
    <thead>
        <tr>
            <th style="width: 40px;"></th>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Category"]</th>
            <th>@Localizer["Type"]</th>
            <th>@Localizer["Description"]</th>
            <th>@Localizer["Options"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var attribute1 in Model)
        {
            <tr data-id="@attribute1.Id" data-version="@attribute1.Version" data-name="@attribute1.Name" data-category="@((int)attribute1.Category)" data-description="@attribute1.Description" data-datatype="@((int)attribute1.DataType)" data-options="@attribute1.DropdownOptionsRaw" data-builtin="@attribute1.IsBuiltIn.ToString().ToLower()" 
                class="attribute-row" data-category-name="@attribute1.Category" data-name-lower="@attribute1.Name.ToLower()" style="cursor: pointer;">
                <td><input type="radio" name="selectedAttribute" class="form-check-input row-select" /></td>
                <td>@attribute1.Name @(attribute1.IsBuiltIn ? "🔒" : "")</td>
                <td>@Localizer[attribute1.Category.ToString()]</td>
                <td>@Localizer[attribute1.DataType.ToString()]</td>
                <td class="text-muted small">@attribute1.Description</td>
                <td>@attribute1.DropdownOptionsRaw</td>
            </tr>
        }
    </tbody>
</table>

<!-- modal for creat and edit-->
<div class="modal fade" id="attributeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">@Localizer["CreateNewAttribute"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="modalError" class="alert alert-danger d-none"></div>
                <input type="hidden" id="attributeId" />
                <input type="hidden" id="attributeVersion" />
                <div class="mb-3">
                    <label class="form-label">@Localizer["Name"]</label>
                    <input type="text" class="form-control" id="attributeName" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@Localizer["Category"]</label>
                    <select id="attributeCategory" class="form-select">
                        @foreach(var cat in Enum.GetValues<CV_mng_sys.Core.Entities.AttributeCategory>()){
                            <option value = "@((int)cat)">@Localizer[cat.ToString()]</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">@Localizer["Description"]</label>
                    <textarea id="attributeDescription" class="form-control" rows="2"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">@Localizer["DataType"]</label>
                    <select class="form-select" id="attributeDataType">
                        <option value="0">@Localizer["String (single-line text)"]</option>
                        <option value="1">@Localizer["Text"]</option>
                        <option value="2">@Localizer["Image"]</option>
                        <option value="3">@Localizer["Numeric"]</option>
                        <option value="4">@Localizer["Date"]</option>
                        <option value="5">@Localizer["Period (date range)"]</option>
                        <option value="6">@Localizer["Boolean (checkbox)"]</option>
                        <option value="7">@Localizer["Dropdown (one of many)"]</option>
                    </select>
                </div>
                <div class="mb-3 d-none" id="dropdownOptionsGroup">
                    <label class="form-label">@Localizer["Options"]</label>
                    <input type="text" class="form-control" id="attributeOptions" placeholder="@Localizer["CommaSeparatedOptions"]" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="button" class="btn btn-primary" id="btnSave">@Localizer["Save"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/attributes.js"></script>
}