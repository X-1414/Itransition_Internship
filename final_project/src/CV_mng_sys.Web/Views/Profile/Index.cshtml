@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CV_mng_sys.Web.SharedResource> Localizer
@model List<(CV_mng_sys.Core.Entities.AttributeDefinition Definition, CV_mng_sys.Core.Entities.CandidateAttributeValue? Value)>
@{
    ViewData["Title"] = $"{Localizer["MyProfile"]} - {Localizer["Info"]}";
}

<h1>@Localizer["MyProfile"]</h1>
@{
    string? targetUserId = ViewBag.TargetUserId;
}
@if (ViewBag.ViewingAsAdmin == true){
    <div class="alert alert-info">Viewing/editing profile for: <strong>@ViewBag.TargetEmail</strong> (as Administrator)</div>
}
<p class="text-muted">@Localizer["FillInValues"]</p>

<table class="table align-middle">
    <thead><tr><th>@Localizer["Attribute"]</th><th>@Localizer["Type"]</th><th>@Localizer["Value"]</th><th style="width:80px;">@Localizer["Status"]</th></tr></thead>
    <tbody>
        @foreach (var (def, val) in Model)
        {
            <tr data-attr-id="@def.Id" data-version="@(val?.Version ?? 0)" data-user-id="@targetUserId">
                <td>@def.Name</td>
                <td>@Localizer[def.DataType.ToString()]</td>
                <td>
                    @if (def.DataType == CV_mng_sys.Core.Entities.AttributeDataType.Dropdown)
                    {
                        <select class="form-select form-select-sm profile-value">
                            <option value="">--</option>
                            @foreach (var opt in def.GetDropdownOptions())
                            {
                                <option value="@opt" selected="@(val?.Value == opt)">@opt</option>
                            }
                        </select>
                    }
                    else if (def.DataType == CV_mng_sys.Core.Entities.AttributeDataType.Boolean)
                    {
                        <input type="checkbox" class="form-check-input profile-value" checked="@(val?.Value == "true")" />
                    }
                    else if (def.DataType == CV_mng_sys.Core.Entities.AttributeDataType.Number)
                    {
                        <input type="number" step="any" class="form-control form-control-sm profile-value" value="@val?.Value" placeholder="@Localizer["AnyNumberPlaceholder"]" />
                    }
                    else if (def.DataType == CV_mng_sys.Core.Entities.AttributeDataType.Date)
                    {
                        <input type="date" class="form-control form-control-sm profile-value" value="@val?.Value"/>
                    }
                    else
                    {
                        <input type="text" class="form-control form-control-sm profile-value" placeholder="@Localizer["FreeText"]" value="@val?.Value" />
                    }
                </td>
                <td class="save-status text-muted small"></td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
     <script>
        window.profileTexts = {
            saving: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Saving"].Value)),
            saved: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Saved"].Value)),
            conflict: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Conflict"].Value)),
            reloading: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Reloading"].Value)),
            error: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Error"].Value)),
            networkError: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["NetworkError"].Value))
        };
    </script>
    <script src="~/js/profile-autosave.js"></script>
}