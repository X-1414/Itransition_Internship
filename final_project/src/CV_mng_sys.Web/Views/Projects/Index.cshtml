@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CV_mng_sys.Web.SharedResource> Localizer
@model List<CV_mng_sys.Core.Entities.Project>
@{ 
    ViewData["Title"] = Localizer["MyProjects"]; 
    string? targetUserId = ViewBag.TargetUserId;
}

<h1>@Localizer["MyProjects"]</h1>
@if (ViewBag.ViewingAsAdmin == true)
{
    <div class="alert alert-info">Viewing/editing projects for: <strong>@ViewBag.TargetEmail</strong> (as Administrator)</div>
}
<div class="mb-3">
    <button id="btnNew" class="btn btn-primary btn-sm">@Localizer["NewProject"]</button>
    <button id="btnEdit" class="btn btn-outline-secondary btn-sm" disabled>@Localizer["Edit"]</button>
    <button id="btnDelete" class="btn btn-outline-danger btn-sm" disabled>@Localizer["Delete"]</button>
</div>
<table class="table table-hover align-middle">
    <thead><tr><th style="width:40px;"></th><th>@Localizer["Name"]</th><th>@Localizer["Period"]</th><th>@Localizer["Tags"]</th></tr></thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr class="project-row" data-id="@p.Id" data-version="@p.Version" data-name="@p.Name"
                data-start="@p.StartDate" data-end="@p.EndDate" data-description="@p.DescriptionMarkdown"
                data-tags="@p.TagsRaw" style="cursor:pointer;">
                <td><input type="radio" name="selectedProject" class="form-check-input row-select" /></td>
                <td>@p.Name</td>
                <td>@p.StartDate?.ToString("yyyy-MM") - @(p.EndDate?.ToString("yyyy-MM") ?? Localizer["Present"])</td>
                <td>
                    @foreach (var tag in p.GetTags())
                    {
                        <span class="badge bg-secondary me-1">@tag</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="modal fade" id="projectModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">@Localizer["NewProject"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="modalError" class="alert alert-danger d-none"></div>
                <input type="hidden" id="projId" />
                <input type="hidden" id="projVersion" />
                <div class="mb-3">
                    <label class="form-label">@Localizer["Name"]</label>
                    <input type="text" id="projName" class="form-control" />
                </div>
                <div class="row mb-3">
                    <div class="col">
                        <label class="form-label">@Localizer["StartDate"]</label>
                        <input type="date" id="projStart" class="form-control" />
                    </div>
                    <div class="col">
                        <label class="form-label">@Localizer["EndDate"]</label>
                        <input type="date" id="projEnd" class="form-control" />
                    </div>
                </div>
                <div class="mb-3 position-relative">
                    <label class="form-label">@Localizer["TechnologyTags"]</label>
                    <input type="text" id="projTags" class="form-control" placeholder="@Localizer["CommaSeparatedTags"]" autocomplete="off" />
                    <div id="tagSuggestions" class="list-group position-absolute w-100" style="z-index: 1000; display: none;"></div>
                    <div class="form-text">@Localizer["TagInstructions"]</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">@Localizer["Description"]</label>
                    <textarea id="projDescription" class="form-control" rows="5"></textarea>
                    <div class="form-label">@Localizer["Preview"]</div>
                    <div id="descriptionPreview" class="border rounded p-2 small"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="button" class="btn btn-primary" id="btnSave">@Localizer["Save"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.projectTexts = {
            newProject: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["NewProject"].Value)),
            editProject: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["EditProject"].Value)),
            somethingWentWrong: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["SomethingWentWrong"].Value)),
            networkError: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["NetworkError"].Value)),
            deleteConfirmation: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["DeleteProjectConfirmation"].Value)),
            couldNotDelete: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["CouldNotDelete"].Value))
        };
    </script>
    <script>window.__targetUserId = @Html.Raw(Json.Serialize(targetUserId));</script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/marked/9.1.6/marked.min.js"></script>
    <script src="~/js/projects.js"></script>
}