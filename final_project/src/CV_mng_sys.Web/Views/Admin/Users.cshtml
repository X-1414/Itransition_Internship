@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CV_mng_sys.Web.SharedResource> Localizer
@model List<CV_mng_sys.Core.Services.UserSummary>
@{
    ViewData["Title"] = Localizer["UserManagement"];
    var allRoles = (string[])ViewBag.AllRoles;
}

<h1>@Localizer["UserManagement"]</h1>
<div class="mb-3">
    <button id="btnBlock" class="btn btn-outline-warning btn-sm" disabled>@Localizer["Block"]</button>
    <button id="btnUnblock" class="btn btn-outline-secondary btn-sm" disabled>@Localizer["Unblock"]</button>
    <button id="btnDelete" class="btn btn-outline-danger btn-sm" disabled>@Localizer["Delete"]</button>
    <select id="roleSelect" class="form-select form-select-sm d-inline-block" style="width:180px;" disabled>
        @foreach (var role in allRoles)
        {
            <option value="@role">@Localizer[role]</option>
        }
    </select>
    <button id="btnAssignRole" class="btn btn-outline-primary btn-sm" disabled>@Localizer["AssignRole"]</button>
    <button id="btnRemoveRole" class="btn btn-outline-secondary btn-sm" disabled>@Localizer["RemoveRole"]</button>
</div>
<div id="actionError" class="alert alert-danger d-none"></div>

<table class="table table-hover align-middle">
    <thead><tr><th style="width:40px"></th><th>@Localizer["Email"]</th><th>@Localizer["Roles"]</th><th>@Localizer["Status"]</th></tr></thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr class="user-row" data-id="@u.Id" data-email="@u.Email" data-blocked="@u.IsBlocked.ToString().ToLower()" style="cursor:pointer;">
                <td><input type="radio" name="selectedUser" class="form-check-input row-select" /></td>
                <td>@u.Email</td>
                <td>@string.Join(", ", u.Roles.Select(r => Localizer[r]))</td>
                <td>
                    @if (u.IsBlocked)
                    {
                        <span class="badge bg-danger">@Localizer["Blocked"]</span>
                    }
                    else
                    {
                        <span class="badge bg-success">@Localizer["Active"]</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        window.userTexts = {
            actionFailed: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ActionFailed"].Value)),
            confirmDelete: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ConfirmDeleteUser"].Value)),
            confirmRemoveRole: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ConfirmRemoveRole"].Value))
        };
    </script>
    <script src="~/js/admin-users.js"></script>
}
