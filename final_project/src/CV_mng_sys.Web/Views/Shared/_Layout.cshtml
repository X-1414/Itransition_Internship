@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CV_mng_sys.Web.SharedResource> Localizer
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Localizer["CV Management System"]</title>
    <script>
        (function () {
            const saved = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', saved);
        })();
    </script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CV_mng_sys.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3" data-bs-theme="auto">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">@Localizer["CV Management System"]</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 justify-content-evenly">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">@Localizer["Home"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Positions" asp-action="Index">@Localizer["Positions"]</a>
                        </li>
                        @if (User.IsInRole("Recruiter") || User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Attributes" asp-action="Index">@Localizer["AttributeLibrary"]</a>
                            </li>
                        }
                        @if (User.IsInRole("Candidate"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Profile" asp-action="Index">@Localizer["MyProfile"]</a>
                            </li>
                        }
                        @if (User.IsInRole("Candidate"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Cv" asp-action="MyCvs">@Localizer["MyCVs"]</a>
                            </li>
                        }
                        @if (User.IsInRole("Candidate"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Projects" asp-action="Index">@Localizer["MyProjects"]</a>
                            </li>
                        }
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Users">@Localizer["UserManagement"]</a>
                            </li>
                        }
                    </ul>
                    <form asp-controller="Home" asp-action="SetLanguage" method="post" class="d-inline me-2">
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <select name="culture" class="form-select form-select-sm d-inline-block" style="width:auto;" onchange="this.form.submit()">
                        <option value="en-US" selected="@(System.Globalization.CultureInfo.CurrentUICulture.Name == "en")">English</option>
                        <option value="ru-RU" selected="@(System.Globalization.CultureInfo.CurrentUICulture.Name == "ru-RU")">Русский</option>
                    </select>
                    </form>
                    <form class="d-flex me-3" asp-controller="Search" asp-action="Index" method="get">
                        <input class="form-control me-2" type="search" name="q" placeholder="@Localizer["SearchPlaceholder"]" />
                        <button class="btn btn-outline-primary" type="submit">@Localizer["Search"]</button>
                    </form>
                    <button id="themeToggle" class="btn btn-outline-secondary btn-sm me-2" type="button" title="Toggle dark/light mode">
                        <span id="themeIcon">🌙</span>
                    </button>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container flex-grow-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - @Localizer["CV Management System"] - <a asp-area="" asp-controller="Home" asp-action="Privacy">@Localizer["PrivacyPolicy"]</a>
            · <a href="#" id="supportTicketLink" class="text-decoration-none">Create support ticket</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/theme-toggle.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <div class="modal fade" id="supportModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create Support Ticket</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="supportError" class="alert alert-danger d-none"></div>
                    <div id="supportSuccess" class="alert alert-success d-none">Ticket submitted successfully!</div>
                    <div class="mb-3">
                        <label class="form-label">Summary</label>
                        <textarea id="ticketSummary" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Priority</label>
                        <select id="ticketPriority" class="form-select">
                            <option value="Low">Low</option>
                            <option value="Average" selected>Average</option>
                            <option value="High">High</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="btnSubmitTicket">Submit</button>
                </div>
            </div>
        </div>
    </div>
    <script src="~/js/support-ticket.js"></script>
</body>
</html>