@model CV_mng_sys.Core.Entities.CvDocument
@{
    ViewData["Title"] = "CV - " + Model.Position.Title;
    bool isOwner = ViewBag.IsOwner;
    bool canPublish = ViewBag.CanPublish;
    var rows = (List<CV_mng_sys.Core.Services.CvAttributeRow>)ViewBag.Rows;
}

<h1>CV: @Model.Position.Title</h1>
<p>
    <span class="badge @(Model.Status == CV_mng_sys.Core.Entities.CvStatus.Published ? "bg-success" : "bg-secondary")">
        @Model.Status
    </span>
    @if (!isOwner)
    {
        <span class="text-muted">Candidate: @Model.CandidateUser.Email</span>
    }
    <span class="ms-3">👍 <span id="likeCount">@ViewBag.LikeCount</span> likes</span>
    @if (User.IsInRole("Recruiter")){
        bool hasLiked = ViewBag.HasLiked;
        <button id="btnLike" class="btn btn-sm @(hasLiked ? "btn-danger" : "btn-outline-danger")" data-cv-id="@Model.Id" data-liked="@hasLiked.ToString().ToLower()">
            @(hasLiked ? "Liked" : "Like")
        </button>}
</p>

@if (isOwner)
{
    <div class="mb-3" id="cvActions" data-cv-id="@Model.Id" data-version="@Model.Version">
        @if (Model.Status == CV_mng_sys.Core.Entities.CvStatus.Draft)
        {
            <button id="btnPublish" class="btn btn-success btn-sm" disabled="@(!canPublish)">Publish</button>
            @if (!canPublish)
            {
                <span class="text-danger small ms-2">Fill in all required (*) fields to publish.</span>
            }
        }
        else
        {
            <button id="btnUnpublish" class="btn btn-outline-secondary btn-sm">Unpublish (back to Draft)</button>
        }
    </div>
}

<table class="table align-middle">
    <thead><tr><th>Attribute</th><th>Value</th><th style="width:80px;">Status</th></tr></thead>
    <tbody>
        @foreach (var row in rows)
        {
            bool isEmpty = string.IsNullOrWhiteSpace(row.Value);
            <tr class="@(isEmpty ? "table-danger" : "")" data-attr-id="@row.AttributeDefinitionId" data-version="@row.ValueVersion">
                <td>@row.Name @(row.IsRequired ? "*" : "")</td>
                <td>
                    @if (!isOwner)
                    {
                        @(isEmpty ? "(empty)" : row.Value)
                    }
                    else if (row.DataType == CV_mng_sys.Core.Entities.AttributeDataType.Dropdown)
                    {
                        <select class="form-select form-select-sm cv-value">
                            <option value="">--</option>
                            @foreach (var opt in row.DropdownOptionsRaw?.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>())
                            {
                                <option value="@opt" selected="@(row.Value == opt)">@opt</option>
                            }
                        </select>
                    }
                    else if (row.DataType == CV_mng_sys.Core.Entities.AttributeDataType.Boolean)
                    {
                        <input type="checkbox" class="form-check-input cv-value" checked="@(row.Value == "true")" />
                    }
                    else if (row.DataType == CV_mng_sys.Core.Entities.AttributeDataType.Number)
                    {
                        <input type="number" step="any" class="form-control form-control-sm cv-value" value="@row.Value" />
                    }
                    else if (row.DataType == CV_mng_sys.Core.Entities.AttributeDataType.Date)
                    {
                        <input type="date" class="form-control form-control-sm cv-value" value="@row.Value" />
                    }
                    else
                    {
                        <input type="text" class="form-control form-control-sm cv-value" value="@row.Value" />
                    }
                </td>
                <td class="save-status text-muted small"></td>
            </tr>
        }
    </tbody>
</table>

@{
    var projects = (List<CV_mng_sys.Core.Entities.Project>)ViewBag.Projects;
}

@if (projects.Any())
{
    <h3 class="mt-4">Relevant Projects</h3>
    @foreach (var proj in projects)
    {
        <div class="card mb-2">
            <div class="card-body">
                <h5 class="card-title">
                    @proj.Name
                    <small class="text-muted">
                        (@proj.StartDate?.ToString("yyyy-MM") - @(proj.EndDate?.ToString("yyyy-MM") ?? "Present"))
                    </small>
                </h5>
                @foreach (var tag in proj.GetTags())
                {
                    <span class="badge bg-secondary me-1">@tag</span>
                }
                <div class="mt-2 markdown-body" data-markdown="@proj.DescriptionMarkdown"></div>
            </div>
        </div>
    }
}


@section Scripts {
    <script src="~/js/cv-details.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/marked/9.1.6/marked.min.js"></script>
    <script>
        document.querySelectorAll('.markdown-body').forEach(el => {
            el.innerHTML = marked.parse(el.dataset.markdown || '');
        });
    </script>
}
