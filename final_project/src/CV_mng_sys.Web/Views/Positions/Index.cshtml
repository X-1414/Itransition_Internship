@model List<CV_mng_sys.Core.Entities.Position>
@{
    ViewData["Title"] = "Positions";
    bool canManage = User.IsInRole("Recruiter") || User.IsInRole("Administrator");
}

<h1>Positions</h1>

@if (canManage)
{
    <div class="mb-3">
        <button id="btnNew" class="btn btn-primary btn-sm">+ New Position</button>
        <button id="btnEdit" class="btn btn-outline-secondary btn-sm" disabled>Edit</button>
        <button id="btnDuplicate" class="btn btn-outline-secondary btn-sm" disabled>Duplicate</button>
        <button id="btnDelete" class="btn btn-outline-danger btn-sm" disabled>Delete</button>
    </div>
}

<table class="table table-hover align-middle">
    <thead><tr><th style="width:40px;"></th><th>Title</th><th>Description</th></tr></thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr class="position-row" data-id="@p.Id" data-version="@p.Version" data-title="@p.Title" data-description="@p.Description" style="cursor:pointer;" onclick="window.location='/Positions/Details/@p.Id'">
                @if (canManage)
                {
                    <td onclick="event.stopPropagation()"><input type="radio" name="selectedPosition" class="form-check-input row-select" /></td>
                }
                else
                {
                    <td></td>
                }
                <td>@p.Title</td>
                <td>@p.Description</td>
            </tr>
        }
    </tbody>
</table>

@if (canManage)
{
    <div class="modal fade" id="positionModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">New Position</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="modalError" class="alert alert-danger d-none"></div>
                    <input type="hidden" id="posId" />
                    <input type="hidden" id="posVersion" />
                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <input type="text" id="posTitle" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea id="posDescription" class="form-control"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="btnSave">Save</button>
                </div>
            </div>
        </div>
    </div>
    @section Scripts {
        <script src="~/js/positions.js"></script>
    }
}